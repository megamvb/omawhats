#!/bin/bash

# Builds omawhatsd and puts it in ~/.local/bin, along with the `omawhats`
# command and its launcher entry. The Omarchy plugin itself needs no installing
# — `omarchy plugin add` clones this folder into place — but the daemon is a Go
# program, and nothing in the plugin flow compiles it.
#
#   ~/.config/omarchy/plugins/megamvb.omawhats/install-daemon
#
# Go comes from the system (pacman) or, if it is not there, from mise, which
# Omarchy already ships. Safe to run again after `omarchy plugin update`: the
# running daemon keeps the old binary until it is turned off and on again.
#
#   -y, --yes   answer the questions with yes (for scripts)
#   --mise      build with mise's Go even if the system has its own

set -euEo pipefail

# Any failure that does not explain itself still says where it stopped: an
# exit with nothing printed leaves the person with nothing to go on.
trap 'rc=$?; echo "install-daemon: stopped at line $LINENO (exit $rc)" >&2' ERR

BIN=omawhatsd
BIN_DIR="${OMAWHATS_BIN_DIR:-$HOME/.local/bin}"
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="$ROOT_DIR/daemon"
APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
GO_MIN=1.27
GO_WANT=latest # what mise is asked for
ASSUME_YES=0
FORCE_MISE=0

fail() {
  echo "install-daemon: $*" >&2
  exit 1
}

have() { command -v "$1" >/dev/null 2>&1; }

interactive() { [[ -t 0 && -t 1 ]]; }

confirm() {
  ((ASSUME_YES)) && return 0
  interactive || return 1
  local answer
  read -r -p "$1 [y/N] " answer
  [[ ${answer,,} == y || ${answer,,} == yes ]]
}

while (($# > 0)); do
  case "$1" in
  -y | --yes)
    ASSUME_YES=1
    shift
    ;;
  --mise)
    FORCE_MISE=1
    shift
    ;;
  -h | --help)
    sed -n '3,15p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
    exit 0
    ;;
  *) fail "unknown option: $1" ;;
  esac
done

# ---- Go: the system's, or mise's

# Prints the bare version of the go reached by the given command, or nothing.
# `|| true` because a go that cannot answer (a mise shim with no version
# selected, a half-installed toolchain) is one to go around, not to die on:
# without it, `set -e` ended the script here with nothing printed at all.
go_version() { "$@" env GOVERSION 2>/dev/null | sed 's/^go//; s/-.*//' || true; }

new_enough() {
  [[ -n ${1:-} ]] || return 1
  [[ $(printf '%s\n%s\n' "$GO_MIN" "$1" | sort -V | head -1) == "$GO_MIN" ]]
}

GO=()
system_version=""
if ((!FORCE_MISE)) && have go; then
  system_version=$(go_version go)
  new_enough "$system_version" && GO=(go)
fi

if ((${#GO[@]} == 0)); then
  if ((FORCE_MISE)); then
    reason="asked for with --mise"
  elif [[ -n $system_version ]]; then
    reason="Go $system_version is here but $GO_MIN or newer is needed"
  elif have go; then
    reason="the go in PATH ($(command -v go)) does not answer \`go env GOVERSION\`"
  else
    reason="Go is not installed"
  fi

  have mise || fail "$reason.
  Install it with either of:
    sudo pacman -S --needed go
    mise use -g go@$GO_WANT      # mise ships with Omarchy"

  echo "$reason; mise can supply Go $GO_WANT just for this build."
  confirm "Use mise's Go? (it downloads a toolchain into ~/.local/share/mise)" || fail "nothing built.
  Install Go with either of:
    sudo pacman -S --needed go
    mise use -g go@$GO_WANT"

  GO=(mise exec "go@$GO_WANT" -- go)
  mise_version=$(go_version "${GO[@]}")
  new_enough "$mise_version" ||
    fail "mise gave Go ${mise_version:-none}, which is not $GO_MIN or newer"
  echo "Using mise's Go $mise_version. To keep it for good: mise use -g go@$GO_WANT"
fi

# ---- build

echo "Building $BIN (this downloads the Go modules the first time)…"
cd "$SRC_DIR"
"${GO[@]}" build -trimpath -o "$BIN" .
install -Dm755 "$BIN" "$BIN_DIR/$BIN"
echo "Installed $BIN_DIR/$BIN"

# ---- the command that opens and quits the whole thing, and its menu entry

install -Dm755 "$ROOT_DIR/omawhats" "$BIN_DIR/omawhats"
# The launcher may not have ~/.local/bin in its PATH, so the entry names the
# command by the path it was just installed at.
desktop=$(mktemp)
trap 'rm -f "$desktop"' EXIT
sed "s|^Exec=omawhats|Exec=$BIN_DIR/omawhats|" "$ROOT_DIR/omawhats.desktop" >"$desktop"
install -Dm644 "$desktop" "$APP_DIR/omawhats.desktop"
echo "Installed $BIN_DIR/omawhats and $APP_DIR/omawhats.desktop"

# ---- what the daemon and the client call out to

missing=()
note() { missing+=("$1"); }

have ffmpeg || note "ffmpeg — animated GIFs arrive as a still frame (pacman -S ffmpeg)"
have wl-paste || note "wl-clipboard — Ctrl+V cannot attach a screenshot, and copying a message does nothing (pacman -S wl-clipboard)"
have notify-send || note "libnotify — no notifications for new messages (pacman -S libnotify)"
have mpv || note "mpv — videos open in whatever xdg-open picks (pacman -S mpv)"
if have pacman && ! pacman -Qq qt6-multimedia-ffmpeg >/dev/null 2>&1; then
  note "qt6-multimedia-ffmpeg — voice messages will not play in the client (pacman -S qt6-multimedia-ffmpeg)"
fi
have omarchy-shell || note "this does not look like an Omarchy install: omarchy-shell is not in PATH"

if ((${#missing[@]})); then
  echo
  echo "Optional pieces that are not here:"
  printf '  - %s\n' "${missing[@]}"
fi

case ":$PATH:" in
*":$BIN_DIR:"*) ;;
*)
  echo
  echo "Note: $BIN_DIR is not in your PATH, so \`$BIN\` and \`omawhats\` will not be"
  echo "found in a terminal — call them by full path, or add the directory to PATH."
  echo "The plugin and the menu entry use full paths, so both work either way."
  ;;
esac

cat <<DONE

Done. Next:
  1. Add the widget to the bar if it is not there yet:
     omarchy plugin enable megamvb.omawhats --section right
  2. Middle-click the icon to turn OmaWhats on, then scan the QR under
     WhatsApp → Settings → Linked devices → Link a device.

To put OmaWhats away for good and call it back only when you want it:
  omawhats quit    stops the daemon and takes the widget off the bar
  omawhats open    puts the widget back where it was and opens the client

Apps → OmaWhats in the menu opens it too, from the entry just installed. For
rows in the menu itself, add these to
~/.config/omarchy/extensions/omarchy-menu.jsonc (nothing here edits it):

  "whatsapp": {"icon":"","label":"WhatsApp","aliases":["whatsapp","omawhats"],"when":"command -v omawhats","action":"omawhats open"},
  "whatsapp-quit": {"icon":"","label":"Quit WhatsApp","when":"omawhats running","action":"omawhats quit"},

Updating later: omarchy plugin update megamvb.omawhats, run this script again,
then turn the daemon off and on once so the new binary is used.
DONE
